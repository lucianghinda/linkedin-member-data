#!/usr/bin/env ruby
# frozen_string_literal: true

# The release gate. Runs the default rake task (tests + rubocop), regenerates the
# YARD Markdown docs and llms.txt, then builds the gem into pkg/ with a SHA256
# checksum beside it. Any failing step stops the rest and exits non-zero.
#
# It does not commit, tag, or push. Those stay in human hands.

require "digest"
require "fileutils"
require "rbconfig"
require "rubygems/package"

class ReleasePreparer
  DEFAULT_RUNNER = ->(command, root) { system(*command, chdir: root) }
  DEFAULT_BUILDER = lambda do |root|
    Dir.chdir(root) do
      gemspec = Dir["*.gemspec"].sort.first
      raise Gem::InvalidSpecificationException, "no *.gemspec found" unless gemspec

      specification = Gem::Specification.load(gemspec)
      raise Gem::InvalidSpecificationException, "cannot load #{gemspec}" unless specification

      FileUtils.mkdir_p("pkg")
      path = File.join("pkg", specification.file_name)
      Gem::Package.build(specification, false, true, path)
      checksum = Digest::SHA256.file(path).hexdigest
      File.write("#{path}.sha256", "#{checksum}  #{File.basename(path)}\n")
      true
    end
  end

  def initialize(
    root: File.expand_path("..", __dir__),
    ruby: RbConfig.ruby,
    runner: DEFAULT_RUNNER,
    builder: DEFAULT_BUILDER,
    stdout: $stdout,
    stderr: $stderr
  )
    @root = root
    @ruby = ruby
    @runner = runner
    @builder = builder
    @stdout = stdout
    @stderr = stderr
  end

  def call
    commands.each do |command|
      next if @runner.call(command, @root)

      @stderr.puts "Release preparation failed: #{command.join(" ")}"
      return false
    end

    return false unless @builder.call(@root)

    @stdout.puts "Built. Next: commit, then `git tag -a v<version> -m v<version>`, then push with --follow-tags."
    true
  rescue StandardError => e
    @stderr.puts "Release preparation failed: #{e.message}"
    false
  end

  private

  def commands
    [
      [@ruby, "-S", "bundle", "exec", "rake"],
      [@ruby, "-S", "bundle", "exec", "rake", "yard"],
      [@ruby, File.join(@root, "bin", "generate_llm.rb")]
    ]
  end
end

exit(ReleasePreparer.new.call ? 0 : 1) if $PROGRAM_NAME == __FILE__
